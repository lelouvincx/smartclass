#!/usr/bin/env bash
set -euo pipefail

step() {
  printf '\n==> %s\n' "$1"
}

step 'Installing the Amp agent runtime'
time .agents/bootstrap-agent-skills setup

step 'Installing the pinned toolchain'
if ! command -v mise > /dev/null 2>&1; then
  curl https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi
mise trust mise.toml
time mise install

node_root="$(mise where node)"
export PATH="$node_root/bin:$PATH"

repo_root="$(pwd -P)"
profile_marker='# SmartClass mise toolchain'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\${PWD}" == "$repo_root" ]]; then
  export PATH="$node_root/bin:\$PATH"
fi
EOF
fi

if [[ "$(node --version)" != 'v26.8.1' ]]; then
  printf 'Expected Node.js v26.8.1; found %s.\n' "$(node --version)" >&2
  exit 1
fi

lock_hash="$(node -e "process.stdout.write(require('crypto').createHash('sha256').update(require('fs').readFileSync('package-lock.json')).digest('hex'))")"
install_marker='node_modules/.smartclass-package-lock.sha256'
if [[ -f "$install_marker" ]] && [[ "$(cat "$install_marker")" == "$lock_hash" ]]; then
  step 'Locked npm dependencies are already installed'
else
  step 'Installing locked npm dependencies'
  time npm ci --no-audit --no-fund
  printf '%s\n' "$lock_hash" > "$install_marker"
fi

step 'Applying local D1 migrations'
time npx wrangler d1 migrations apply smartclass --local

step 'Seeding the local D1 database'
for seed_file in worker/db/seeds/*.sql; do
  time npx wrangler d1 execute smartclass --local --file "$seed_file"
done

step 'Orb setup complete'
