#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$repo_root/.agents/bootstrap-agent-skills" resume

export PATH="$HOME/.local/bin:$PATH"
cd "$repo_root"

printf '\n==> Seeding the local D1 database\n'
for seed_file in worker/db/seeds/*.sql; do
  time mise exec -- npx wrangler d1 execute smartclass --local --file "$seed_file"
done
